{
  "name": "saucedemo-ui-automation",
  "version": "1.0.0",
  "private": true,
  "description": "SauceDemo UI automation with Selenium, Mocha and Page Object Model",
  "type": "commonjs",
  "scripts": {
    "test": "mocha \"tests/**/*.test.js\" --reporter spec --timeout 60000",
    "test:login": "mocha \"tests/login/**/*.test.js\" --reporter spec --timeout 60000",
    "test:products": "mocha \"tests/products/**/*.test.js\" --reporter spec --timeout 60000",
    "test:cart": "mocha \"tests/cart/**/*.test.js\" --reporter spec --timeout 60000",
    "test:checkout": "mocha \"tests/checkout/**/*.test.js\" --reporter spec --timeout 60000",
    "test:report": "mocha \"tests/**/*.test.js\" --reporter mochawesome --reporter-options reportDir=reports,reportFilename=ui-test-report,overwrite=true,html=true,json=true,consoleReporter=spec --timeout 60000"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "dotenv": "18.0.3",
    "selenium-webdriver": "4.49.0"
  },
  "devDependencies": {
    "chai": "4.5.0",
    "mocha": "12.0.2",
    "mochawesome": "^8.1.1"
  }
}
